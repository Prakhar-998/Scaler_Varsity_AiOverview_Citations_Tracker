# Which SERP adapter to use (serphouse | fake)
SERP_PROVIDER=serphouse
SERPHOUSE_API_KEY=
# OpenRouter (default LLM provider). Either name works.
OPENROUTER_KEY=
# OPENROUTER_API_KEY=
# Optional: comma-separated :free models, tried in order (overrides settings.yaml)
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free,google/gemma-4-31b-it:free
# Gemini is off by default (llm.chain in settings.yaml)
GEMINI_API_KEY=
# Optional: overrides gemini_model in config/settings.yaml
GEMINI_MODEL=
# Path to the service account JSON file, or the JSON itself
GOOGLE_SERVICE_ACCOUNT_JSON=
# Test sheet ID (not the Organic Tracker)
SHEET_ID=
